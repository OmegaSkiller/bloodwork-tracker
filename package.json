{
  "name": "bloodwork-local",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "demo": "node --env-file-if-exists=.env server/demo.mjs",
    "setup": "node --env-file-if-exists=.env server/setup.mjs",
    "import": "node --env-file-if-exists=.env server/import-cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "check": "npm test && npm run build && node --check server/index.mjs && node --check server/db.mjs && node --check shared/ai.js",
    "release:export": "node scripts/export-public.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@e965/xlsx": "^0.20.3",
    "@radix-ui/react-popover": "^1.1.23",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.9",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.9",
    "vite": "^6.1.0"
  }
}
