# Local-only defaults. No provider credentials are required for tracking or demo.
HOST=127.0.0.1
PORT=8787
VITE_PORT=5173
BLOODWORK_DB_PATH=./data/bloodwork.sqlite
AUTH_USERNAME=admin
AUTH_SESSION_HOURS=12
# Set NODE_ENV=production behind HTTPS for Secure, __Host- session cookies.
# Trust only your actual reverse proxy address/subnet, never arbitrary clients.
TRUST_PROXY=
# Optional legacy htpasswd migration; no machine-specific path is assumed.
AUTH_HTPASSWD_PATH=

# Optional operator-supplied keys. All authorized users can use configured AI.
OPENAI_API_KEY=
OPENAI_API_KEY_PATH=./data/openai-api-key
OPENAI_ATTEMPTS=2
OPENAI_TIMEOUT_MS=180000
OPENROUTER_KEY=
OPENROUTER_REFERER=http://localhost:8787
OPENROUTER_ATTEMPTS=2
OPENROUTER_TIMEOUT_MS=60000
